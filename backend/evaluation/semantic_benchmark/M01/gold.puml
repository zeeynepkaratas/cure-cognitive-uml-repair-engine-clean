@startuml
class Citizen {
  +id: String
}
class Complaint {
  +id: String
}
class RegistrationDesk {
  +id: String
}
class PoliceOfficer {
  +id: String
}
Citizen "1" --> "0..*" Complaint
Complaint "0..*" --> "1" RegistrationDesk
RegistrationDesk "1" *-- "1..*" PoliceOfficer
Citizen "0..*" --> "0..*" PoliceOfficer
@enduml