@startuml
class Investigation {
  +id: String
}
class Task {
  +id: String
}
class InvestigationModule {
  +id: String
}
class CaseRecord {
  +id: String
}
Investigation "1" --> "0..*" Task
Task "0..*" --> "1" InvestigationModule
InvestigationModule "1" *-- "1..*" CaseRecord
Investigation "0..*" --> "0..*" CaseRecord
@enduml