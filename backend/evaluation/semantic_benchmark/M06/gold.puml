@startuml
class Constable {
  +id: String
}
class PoliceStation {
  +id: String
}
class Court {
  +id: String
}
class CourtInteraction {
  +id: String
}
Constable "1" --> "0..*" PoliceStation
PoliceStation "0..*" --> "1" Court
Court "1" *-- "1..*" CourtInteraction
Constable "0..*" --> "0..*" CourtInteraction
@enduml