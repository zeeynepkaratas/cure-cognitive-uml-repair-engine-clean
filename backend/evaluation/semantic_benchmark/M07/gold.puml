@startuml
class CourtInteraction {
  +id: String
}
class Entry {
  +id: String
}
class ProsecutionModule {
  +id: String
}
class CaseFile {
  +id: String
}
CourtInteraction "1" --> "0..*" Entry
Entry "0..*" --> "1" ProsecutionModule
ProsecutionModule "1" *-- "1..*" CaseFile
CourtInteraction "0..*" --> "0..*" CaseFile
@enduml