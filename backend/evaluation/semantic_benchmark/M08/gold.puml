@startuml
class PoliceOfficer {
  +id: String
}
class SearchQuery {
  +id: String
}
class SearchService {
  +id: String
}
class CaseResult {
  +id: String
}
PoliceOfficer "1" --> "0..*" SearchQuery
SearchQuery "0..*" --> "1" SearchService
SearchService "1" *-- "1..*" CaseResult
PoliceOfficer "0..*" --> "0..*" CaseResult
@enduml