@startuml
class Sender {
  +id: String
}
class Parcel {
  +id: String
}
class TrackingService {
  +id: String
}
class TrackingEvent {
  +id: String
}
Sender "1" --> "0..*" Parcel
Parcel "0..*" --> "1" TrackingService
TrackingService "1" *-- "1..*" TrackingEvent
Sender "0..*" --> "0..*" TrackingEvent
@enduml