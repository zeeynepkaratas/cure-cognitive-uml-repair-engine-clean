@startuml
class Guest {
  +id: String
}
class Reservation {
  +id: String
}
class ReservationService {
  +id: String
}
class Room {
  +id: String
}
Guest "1" --> "0..*" Reservation
Reservation "0..*" --> "1" ReservationService
ReservationService "1" *-- "1..*" Room
Guest "0..*" --> "0..*" Room
@enduml