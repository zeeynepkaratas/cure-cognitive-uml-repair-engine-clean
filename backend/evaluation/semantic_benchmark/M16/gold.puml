@startuml
class Technician {
  +id: String
}
class WorkOrder {
  +id: String
}
class MaintenanceService {
  +id: String
}
class Machine {
  +id: String
}
Technician "1" --> "0..*" WorkOrder
WorkOrder "0..*" --> "1" MaintenanceService
MaintenanceService "1" *-- "1..*" Machine
Technician "0..*" --> "0..*" Machine
@enduml