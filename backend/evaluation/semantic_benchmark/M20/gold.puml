@startuml
class Candidate {
  +id: String
}
class Application {
  +id: String
}
class RecruitmentService {
  +id: String
}
class Vacancy {
  +id: String
}
Candidate "1" --> "0..*" Application
Application "0..*" --> "1" RecruitmentService
RecruitmentService "1" *-- "1..*" Vacancy
Candidate "0..*" --> "0..*" Vacancy
@enduml