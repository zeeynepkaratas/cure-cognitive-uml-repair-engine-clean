@startuml
class Requester {
  +id: String
}
class SupportTicket {
  +id: String
}
class HelpDeskService {
  +id: String
}
class Resolution {
  +id: String
}
Requester "1" --> "0..*" SupportTicket
SupportTicket "0..*" --> "1" HelpDeskService
HelpDeskService "1" *-- "1..*" Resolution
Requester "0..*" --> "0..*" Resolution
@enduml