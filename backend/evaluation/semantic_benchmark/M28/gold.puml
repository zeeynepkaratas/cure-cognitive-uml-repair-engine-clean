@startuml
class Diner {
  +id: String
}
class TableBooking {
  +id: String
}
class RestaurantService {
  +id: String
}
class Table {
  +id: String
}
Diner "1" --> "0..*" TableBooking
TableBooking "0..*" --> "1" RestaurantService
RestaurantService "1" *-- "1..*" Table
Diner "0..*" --> "0..*" Table
@enduml