@startuml
class Volunteer {
  +id: String
}
class Shift {
  +id: String
}
class SchedulingService {
  +id: String
}
class Activity {
  +id: String
}
Volunteer "1" --> "0..*" Shift
Shift "0..*" --> "1" SchedulingService
SchedulingService "1" *-- "1..*" Activity
Volunteer "0..*" --> "0..*" Activity
@enduml